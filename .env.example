# Public frontend setting.
# Leave empty for the GitHub Pages demo/localStorage mode.
# Use "/api" for same-origin Vercel production, or "https://your-domain.com/api".
VITE_API_BASE_URL=

# Server-only Vercel/Supabase production settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=memory-media

# sha256 hex of the private editor key. Generate locally with:
# node -e "const crypto=require('crypto'); console.log(crypto.createHash('sha256').update('your-editor-key').digest('hex'))"
EDITOR_SECRET_HASH=

# Random high-entropy string for signing HttpOnly editor cookies.
EDITOR_SESSION_SECRET=

# Bearer token for the Vercel cron keepalive endpoint.
CRON_SECRET=
